PORT=3000
# Số proxy đáng tin trước app (mặc định 1 = Vercel). Chạy VPS không qua proxy thì đặt 0 để chống giả IP qua X-Forwarded-For
TRUST_PROXY=1
# Cookie đăng nhập (HttpOnly): bật Secure khi chạy HTTPS. Mặc định tự bật ở production (Vercel), tắt khi dev local HTTP
# COOKIE_SECURE=1
# Local: mongodb://127.0.0.1:27017/coolair  |  Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/coolair
MONGODB_URI=mongodb://127.0.0.1:27017/coolair
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Upload ảnh (Cloudinary): cloudinary.com -> Console -> Dashboard -> Product Environment Credentials. Thiếu = nút tải ảnh báo chưa cấu hình
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=coolair

# Gửi email xác thực (ví dụ Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=mat-khau-ung-dung
MAIL_FROM=CoolAir <you@gmail.com>

# Realtime chat (https://ably.com -> tạo app -> API Keys). Để trống = tắt realtime, chat quay về hỏi lại định kỳ
ABLY_API_KEY=

# Địa chỉ web chính (không có / ở cuối). BẮT BUỘC khi deploy: dùng để tạo link trong RSS (/api/rss.xml) và email mời bạn bè. Thiếu = link RSS gãy, email mời chỉ hiện mã mời
SITE_URL=https://coolair-cua-ban.vercel.app

# Gọi thoại/video - TURN, chọn MỘT trong hai (ưu tiên Metered nếu có đủ). Để trống cả hai = chỉ STUN, ~10-20% cuộc gọi có thể không nối được
# (1) Metered Open Relay - 20GB/tháng miễn phí, không cần thẻ: metered.ca/tools/openrelay -> đăng ký -> Dashboard
METERED_APP=tên-app-của-bạn   # phần trước .metered.live
METERED_API_KEY=
METERED_REGION=asia
# (2) Cloudflare TURN (dash.cloudflare.com -> Realtime -> TURN Server -> Create). Để trống = chỉ STUN, ~10-20% cuộc gọi có thể không nối được
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# Chẩn đoán đăng nhập: đặt 1 để báo rõ sai ở tên hay ở mật khẩu (nhớ xóa sau khi xong). Log LOGIN luôn có trong Vercel -> Logs
LOGIN_DEBUG=

# Quản trị viên (quản lý trường hồ sơ mở rộng): danh sách email, cách nhau bằng dấu phẩy. Để trống = không ai là quản trị viên
ADMIN_EMAILS=

# Đăng nhập một lần giữa domain chính và domain phụ (cùng backend + MongoDB + JWT_SECRET). Để trống SSO_MAIN_ORIGIN = tắt
SSO_MAIN_ORIGIN=
SSO_ALLOWED_ORIGINS=

# Thông báo đẩy (Web Push) ra điện thoại / trình duyệt. Tạo khóa bằng: node server/genvapid.js  (để trống = tắt, thông báo trong app vẫn chạy)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron (/api/cron/cleanup): chuỗi ngẫu nhiên >= 16 ký tự. Thiếu thì endpoint luôn trả 401.
CRON_SECRET=
